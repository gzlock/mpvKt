# Local release signing configuration. Copy this file to .env and fill in
# the values; never commit the populated .env file.
BUILD_RELEASE_KEYSTORE=C:\path\to\release.keystore
BUILD_RELEASE_KEY_ALIAS=mpvkt
BUILD_RELEASE_STORE_PASSWORD=
BUILD_RELEASE_KEY_PASSWORD=

# Optional when Android SDK environment variables are not configured.
# APKSIGNER=C:\Android\Sdk\build-tools\37.0.0\apksigner.bat
